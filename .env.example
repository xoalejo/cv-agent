# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca se commitea.

# --- Proveedor del modelo (obligatorio) --------------------------------------
OPENAI_API_KEY=sk-tu-clave-aqui

# Esfuerzo de razonamiento: minimal | low | medium | high.
# Esta familia de modelos no admite 'temperature'; este es el control
# equivalente. 'low' basta para responder con datos ya presentes en el contexto.
REASONING_EFFORT=low

# Modelo que usa el servidor. Se ignora deliberadamente el que envíe el cliente.
OPENAI_MODEL=gpt-5.6-luna

# --- Seguridad del endpoint --------------------------------------------------
# Bearer token que debe presentar quien consuma /responses. Es el valor que se
# registra en el campo "Clave de API" de la plataforma.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Ponlo en false solo para desarrollo local sin credencial.
REQUIRE_AUTH=true

# Límite de tasa por cliente.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Orígenes CORS separados por coma. Vacío = sin CORS (integración
# servidor-a-servidor). Nunca uses "*".
CORS_ALLOW_ORIGINS=

# --- Operación ---------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_TOOL_ITERATIONS=5
REQUEST_TIMEOUT_SECONDS=60

# --- Despliegue (solo para publicar en Hugging Face Spaces) ------------------
# Token con permiso de escritura sobre el Space. No lo necesita el servicio en
# ejecución, solo el script deploy/huggingface/sync.py.
# Genéralo en https://huggingface.co/settings/tokens
HF_TOKEN=
